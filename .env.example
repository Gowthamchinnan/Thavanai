# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used by Auth.js to sign session cookies. Never reuse the example value in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Set to true when running behind a reverse proxy (nginx, Caddy, Vercel, etc.)
AUTH_TRUST_HOST="true"

# Public origin of the application (used for cookies/redirects in production).
NEXTAUTH_URL="http://localhost:3000"

# ---- One-time administrator bootstrap (npm run admin:setup) ----
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Thavanai Admin"
# Optional. If unset, admin:setup prints a generated one-time password.
# ADMIN_PASSWORD="choose-a-strong-password"

